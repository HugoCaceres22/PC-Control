<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <AssemblyName>PCControl</AssemblyName><ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>assets/pc-control.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup><PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" /><PackageReference Include="System.Diagnostics.PerformanceCounter" Version="8.0.1" /></ItemGroup>
  <ItemGroup><Compile Remove="tests/**/*.cs" /></ItemGroup>
  <ItemGroup><Resource Include="assets/pc-control.png" /></ItemGroup>
  <ItemGroup><Content Include="tools/**/*;licenses/**/*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" /></ItemGroup>
  <ItemGroup><Content Include="README.md;LICENSE;TERCEROS.md;DEPENDENCIAS.md;PRUEBAS.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" /></ItemGroup>
</Project>
