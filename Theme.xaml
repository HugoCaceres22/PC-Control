<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 
  <SolidColorBrush x:Key="Accent" Color="#51E3D5"/>
<SolidColorBrush x:Key="SurfaceBackground" Color="#191D2A"/>
<SolidColorBrush x:Key="ButtonBackground" Color="#272C40"/>
<SolidColorBrush x:Key="ButtonHover" Color="#41496A"/>
<SolidColorBrush x:Key="InputBackground" Color="#242A3D"/>
<SolidColorBrush x:Key="BorderColor" Color="#414860"/>
<SolidColorBrush x:Key="TabBackground" Color="#101219"/>
<Style x:Key="GamingThemeToggle" TargetType="ToggleButton">
 <Setter Property="Foreground" Value="#D6DCEC"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="0,4,0,4"/><Setter Property="Cursor" Value="Hand"/>
 <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton">
  <Border x:Name="Frame" Background="#1B2030" BorderBrush="#4B546D" BorderThickness="1" CornerRadius="7" Padding="12,12">
   <StackPanel Orientation="Horizontal"><TextBlock Text="Modo gaming" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="SemiBold"/>
    <Border x:Name="Pill" Background="#363E54" CornerRadius="10" Padding="8,3"><TextBlock x:Name="State" Text="OFF" FontFamily="Consolas" FontWeight="Bold" Foreground="#C5CCDE" FontSize="12" Margin="0"/></Border>
   </StackPanel>
  </Border>
  <ControlTemplate.Triggers>
   <Trigger Property="IsChecked" Value="True"><Setter TargetName="Frame" Property="Background" Value="#25102E"/><Setter TargetName="Frame" Property="BorderBrush" Value="#FF4BA8"/><Setter Property="Foreground" Value="#FFFFFF"/><Setter TargetName="Pill" Property="Background" Value="#C1FF38"/><Setter TargetName="State" Property="Foreground" Value="#101708"/><Setter TargetName="State" Property="Text" Value="ON"/></Trigger>
   <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="#C1FF38"/></Trigger>
   <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderThickness" Value="2"/></Trigger>
  </ControlTemplate.Triggers>
 </ControlTemplate></Setter.Value></Setter>
</Style>
  <Style TargetType="Window"><Setter Property="Background" Value="{DynamicResource TabBackground}"/><Setter Property="Foreground" Value="#EEF1FA"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="FontSize" Value="14"/></Style>
  <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style TargetType="Button"><Setter Property="Background" Value="{DynamicResource ButtonBackground}"/><Setter Property="Foreground" Value="#F1F4FC"/><Setter Property="Padding" Value="14,9"/><Setter Property="Margin" Value="0,4,8,4"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="{DynamicResource ButtonHover}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="B" Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="#202535"/><Setter Property="Foreground" Value="White"/><Setter Property="CaretBrush" Value="White"/><Setter Property="Padding" Value="9"/><Setter Property="Margin" Value="0,4,8,10"/><Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/></Style>
  <Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="#EEF1FA"/><Setter Property="Background" Value="{DynamicResource InputBackground}"/><Setter Property="Padding" Value="9,7"/></Style>
  <Style TargetType="ComboBox"><Setter Property="Margin" Value="0,4,8,10"/><Setter Property="Padding" Value="10"/><Setter Property="MinWidth" Value="130"/><Setter Property="MaxWidth" Value="600"/><Setter Property="Foreground" Value="#EEF1FA"/><Setter Property="Background" Value="{DynamicResource InputBackground}"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid><ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="{DynamicResource InputBackground}" CornerRadius="6" Padding="10"><TextBlock Text="⌄" Foreground="{DynamicResource Accent}" HorizontalAlignment="Right"/></Border></ControlTemplate></ToggleButton.Template></ToggleButton><ContentPresenter Margin="10,8,30,8" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" VerticalAlignment="Center"/><Popup Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade"><Border Background="{DynamicResource InputBackground}" BorderBrush="#515B7D" BorderThickness="1" MinWidth="{Binding ActualWidth,RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="320"><ScrollViewer CanContentScroll="True"><ItemsPresenter/></ScrollViewer></Border></Popup></Grid></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#EEF1FA"/><Setter Property="Margin" Value="0,8,0,10"/></Style>
  <Style TargetType="TabControl"><Setter Property="Background" Value="{DynamicResource TabBackground}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Foreground" Value="White"/></Style>
  <Style TargetType="TabItem"><Setter Property="Padding" Value="20,12"/><Setter Property="Foreground" Value="#A7AEC5"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="TabBorder" BorderThickness="0,0,0,2" BorderBrush="Transparent" Background="{DynamicResource TabBackground}" Padding="{TemplateBinding Padding}"><ContentPresenter ContentSource="Header"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="{DynamicResource Accent}"/><Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabBorder" Property="Background" Value="#202535"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 
</ResourceDictionary>


